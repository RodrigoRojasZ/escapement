# Copia este archivo a .env y ajusta lo que necesites. .env está en .gitignore.

# --- Autenticación de Claude ---
# Opcional si ya usas Claude Code autenticado (el SDK reusa esa sesión).
# ANTHROPIC_API_KEY=sk-ant-...

# --- Vault de memoria (opcional; por defecto ~/.claude/...) ---
# El vault NO se incluye en el repo: son tus notas markdown personales.
# AGENT_NAME=Escapement
# AGENT_PROJECTS_DIR=C:\Users\<tu-usuario>\.claude\projects
# AGENT_RECALL_SCRIPT=C:\Users\<tu-usuario>\.claude\tools\recall_memory.py

# --- Voz: STT local (opcional; también configurable en [voice] de escapement.toml) ---
# Default: large-v3-turbo (multilingüe es/en, ~1.6 GB VRAM en float16; large-v3 usa ~3 GB).
# Los modelos distil-* son SOLO inglés: no sirven para code-switching es/en.
# AGENT_VOICE_STT_MODEL=large-v3-turbo
# AGENT_VOICE_STT_DEVICE=cuda
# AGENT_VOICE_STT_COMPUTE=float16

# --- Voz: wake word manos libres (opcional; default apagada = solo F2) ---
# Preentrenados openWakeWord: hey_jarvis, alexa, hey_mycroft; o ruta a un .onnx custom.
# AGENT_VOICE_WAKE_WORD=hey_jarvis
# AGENT_VOICE_WAKE_THRESHOLD=0.5
